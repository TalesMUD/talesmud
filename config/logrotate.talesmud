# Optional OS-level safety net for TalesMUD logs.
# Primary rotation is lumberjack inside the process (MaxAge=7 days).
# Install on VPS: sudo cp config/logrotate.talesmud /etc/logrotate.d/talesmud
#
# Log path (working directory of the systemd service).
# Example: $HOME/dev/talesmud/logs/talesmud.log
# Replace the path below before installing this file.

/var/log/talesmud/talesmud.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    dateext
}
