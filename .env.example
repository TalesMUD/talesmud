# Application settings
GIN_MODE=debug
LOG_LEVEL=debug
PORT=8010

# Authentication
# Auth0 protects registered-user API and WebSocket routes. Guest sessions use local HMAC tokens.
AUTH_ENABLED=false

# Legacy admin import/export credentials. Leave either value blank to disable those endpoints.
# Never use admin/admin in release mode.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Auth0
AUTH0_AUDIENCE=http://localhost:8010/api
AUTH0_DOMAIN=https://your-tenant.auth0.com/
AUTH0_WK_JWKS=https://your-tenant.auth0.com/.well-known/jwks.json

# Guest mode secret key for signing guest JWTs (HMAC-SHA256)
# If not set, a random key is generated at startup (guest tokens won't survive server restart)
GUEST_SECRET=

# SQLite database path
SQLITE_PATH=./talesmud.db

# Background images storage path
BACKGROUNDS_PATH=./uploads/backgrounds
